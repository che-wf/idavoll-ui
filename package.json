{
  "name": "idavoll-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, open-source React components built on shadcn/ui, installed with the shadcn CLI.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "vite",
    "build": "pnpm registry:build && vite build",
    "preview": "vite preview",
    "registry:build": "shadcn build",
    "registry:validate": "shadcn registry validate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm registry:validate",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:a11y": "node scripts/a11y.mjs",
    "check:secrets": "gitleaks git --redact --no-banner",
    "check:private": "bash scripts/check-private-terms.sh --all"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-table": "8.21.3",
    "astronomy-engine": "2.1.19",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
