#!/usr/bin/env bash
# Blocks commits that contain secrets or personal details. Installed by `pnpm install`
# (scripts/setup-hooks.mjs).
set -euo pipefail

red() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

# 1. Refuse secret-looking or local-only files even if someone force-adds them past .gitignore.
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E \
  '(^|/)\.env($|\.)|\.env$|\.local($|\.)|\.(pem|key|crt|p12|pfx|jks|keystore|age|gpg|dump|backup)$|(^|/)(client_secret|credentials|service-account|tokens?)[^/]*\.json$|(^|/)id_(rsa|ed25519|ecdsa)' \
  | grep -vE '\.example$' || true)
if [[ -n "$blocked" ]]; then
  red "Commit blocked: these files are secret or local-only and must not be committed:"
  printf '  %s\n' $blocked >&2
  red "Unstage them with: git rm --cached <file>"
  exit 1
fi

# 2. Scan staged changes for secrets.
if ! command -v gitleaks >/dev/null 2>&1; then
  red "Commit blocked: gitleaks is not installed, so secrets can't be checked."
  red "Install it (see README > Security) and commit again."
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner

# 3. Keep personal details (your own list in .private-terms.local) out of the repo.
bash scripts/check-private-terms.sh



